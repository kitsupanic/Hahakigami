{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window may use analyzer commands.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "clipboard-manager:allow-write-text",
    "allow-saved-scans-enabled",
    "allow-list-saved-scans",
    "allow-import-saved-scan",
    "allow-export-saved-scan",
    "allow-save-scan",
    "allow-begin-saved-open",
    "allow-cancel-saved-open",
    "allow-open-saved-scan",
    "allow-delete-saved-scan",
    "allow-compare-saved-scans",
    "allow-compare-current-scan",
    "allow-rescan-saved-scan",
    "allow-discover-targets",
    "allow-mounted-volumes",
    "allow-choose-folder",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-discard-scan",
    "allow-scan-summary",
    "allow-get-scan-issues",
    "allow-get-node",
    "allow-get-children",
    "allow-get-map",
    "allow-search-nodes",
    "allow-filter-nodes",
    "allow-get-file-types",
    "allow-get-file-type-highlights",
    "allow-get-explorer-preferences",
    "allow-set-explorer-sort",
    "allow-quick-look-node",
    "allow-close-quick-look",
    "allow-reveal-node",
    "allow-list-cleanup-queue",
    "allow-add-cleanup-queue",
    "allow-remove-cleanup-queue",
    "allow-clear-cleanup-queue",
    "allow-cleanup-queue-target",
    "allow-prepare-cleanup-queue",
    "allow-commit-cleanup-queue",
    "allow-prepare-trash",
    "allow-commit-trash",
    "allow-open-full-disk-access",
    "allow-full-disk-access-status",
    "allow-scan-without-full-disk-access",
    "allow-restart-app"
  ]
}
